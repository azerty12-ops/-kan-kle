# Configuration du Bot Telegram
TELEGRAM_BOT_TOKEN=votre_token_telegram_ici

# Autorisation (ID de l'utilisateur Telegram autorisé)
ALLOWED_USER_ID=votre_id_telegram_ici

# Configuration Gemini (Google AI)
GEMINI_API_KEY=votre_cle_gemini_ici

# Chemins des dossiers (à adapter selon votre ordinateur)
FOLDER_TO_ORGANIZE=C:/Users/VotreNom/Downloads
FOLDER_DESTINATION=C:/Users/VotreNom/Documents/Classement
