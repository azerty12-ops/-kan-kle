# Configuration du Bot Telegram
TELEGRAM_BOT_TOKEN=votre_token_telegram_ici

# Configuration Gemini (Google AI)
GEMINI_API_KEY=votre_cle_gemini_ici

# Configuration Odoo
ODOO_URL=https://votre-domaine.odoo.com
ODOO_DB=nom_de_la_base_de_donnees
ODOO_USERNAME=votre_email_odoo
ODOO_PASSWORD=votre_mot_de_passe_ou_api_key

# Chemins des dossiers (à adapter selon votre ordinateur)
FOLDER_TO_ORGANIZE=C:/Users/VotreNom/Downloads
FOLDER_DESTINATION=C:/Users/VotreNom/Documents/Classement

# Google Calendar (Chemin vers le fichier credentials.json téléchargé depuis Google Cloud)
GOOGLE_CREDENTIALS_PATH=config/credentials.json
ALLOWED_USER_ID=123456789
